@using System.Linq

<div class="form-group">
    <div class="form-label-row">
        <label for="@Id" class="form-label">@Label</label>
        @if (!string.IsNullOrEmpty(LabelLinkText))
        {
            <a href="@LabelLinkHref" class="form-label-link">@LabelLinkText</a>
        }
    </div>
    <div class="input-wrapper @(HasError ? "has-error" : "")">
        <input
            id="@Id"
            type="@CurrentInputType"
            class="form-input @(HasError ? "form-input-error" : "")"
            placeholder="@Placeholder"
            value="@Value"
            @oninput="@((ChangeEventArgs e) => OnValueChanged.InvokeAsync(e.Value?.ToString()))"
            disabled="@Disabled" />
        @if (ShowIcon && Type == "password")
        {
            <button type="button" class="eye-toggle" @onclick="ToggleVisibility">
                @if (_showPassword)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                        <line x1="1" y1="1" x2="23" y2="23" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                }
            </button>
        }
    </div>

    @if (ShowPasswordStrength && !string.IsNullOrEmpty(Value))
    {
        <div class="password-hints">
            <span class="hint @(HasSpecialChar ? "hint-met" : "")">✓ Special character (@@ # $ etc.)</span>
            <span class="hint @(HasUppercase ? "hint-met" : "")">✓ Uppercase letter (A–Z)</span>
            <span class="hint @(HasMinLength ? "hint-met" : "")">✓ Minimum 8 characters</span>
            <span class="hint @(HasNumber ? "hint-met" : "")">✓ number (0–9)</span>
            <span class="hint @(HasLowercase ? "hint-met" : "")">✓ Lowercase letter (a–z)</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="input-error-message">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
            </svg>
            @ErrorMessage
        </div>
    }
</div>

@code {
    private bool _showPassword;

    private string CurrentInputType => (Type == "password" && _showPassword) ? "text" : Type;
    private bool HasError => !string.IsNullOrEmpty(ErrorMessage);
    private bool HasSpecialChar => Value.Any(c => !char.IsLetterOrDigit(c));
    private bool HasUppercase => Value.Any(char.IsUpper);
    private bool HasLowercase => Value.Any(char.IsLower);
    private bool HasNumber => Value.Any(char.IsDigit);
    private bool HasMinLength => Value.Length >= 8;

    private void ToggleVisibility() => _showPassword = !_showPassword;

    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowIcon { get; set; } = true;
    [Parameter] public string ErrorMessage { get; set; } = string.Empty;
    [Parameter] public bool ShowPasswordStrength { get; set; }
    [Parameter] public string LabelLinkText { get; set; } = string.Empty;
    [Parameter] public string LabelLinkHref { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnValueChanged { get; set; }
}
