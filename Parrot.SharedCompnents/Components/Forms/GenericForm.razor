@using Parrot.SharedComponents.Components.InputFields

<div class="generic-form-container">
    <form @onsubmit="HandleSubmit">
        <div class="generic-form-input">
            @foreach (var field in Fields)
            {
                <FormInput Id="@field.Id"
                           Label="@field.Label"
                           Type="@field.Type"
                           Placeholder="@field.Placeholder"
                           Value="@field.Value"
                           ShowIcon="@field.ShowIcon"
                           Disabled="@field.Disabled"
                           ErrorMessage="@field.ErrorMessage"
                           ShowPasswordStrength="@field.ShowPasswordStrength"
                           LabelLinkText="@field.LabelLinkText"
                           LabelLinkHref="@field.LabelLinkHref"
                           OnValueChanged="@((value) => UpdateFieldValueAndNotify(field.Id, value))" />
            }
        </div>
        @if (AdditionalContent != null)
        {
            @AdditionalContent
        }
        <button type="submit" class="submit-button @(PrimaryButton ? "submit-button--primary" : "")">@SubmitButtonText</button>
    </form>
</div>
