@namespace Parrot.Web.Components.Shared

<ModalShell Visible="Visible" Size="sm" ExtraClass="modal-dialog--confirm" ShowDivider="false" ShowCloseButton="false"
            FooterClass="modal-footer--confirm" OnClose="OnCancel">
    <BodyContent>
        <div class="delete-header">
        <div class="modal-confirm-icon modal-confirm-icon--warn">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>
        <h2 class="modal-title">@Title</h2>
        <p class="modal-sub">@Description</p>
        </div>
    </BodyContent>
    <FooterContent>
        <button class="modal-btn modal-btn--cancel" @onclick="OnCancel">Cancel</button>
        <button class="modal-btn modal-btn--delete" @onclick="HandleConfirm">@ConfirmLabel</button>
    </FooterContent>
</ModalShell>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Are you sure?";
    [Parameter] public string Description { get; set; } = "This action cannot be undone.";
    [Parameter] public string ConfirmLabel { get; set; } = "Delete";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task HandleConfirm() => await OnConfirm.InvokeAsync();
}
