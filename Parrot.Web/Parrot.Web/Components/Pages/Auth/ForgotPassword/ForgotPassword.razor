@page "/forgot-password"
@layout AuthLayout
@using Parrot.SharedComponents.Components.Forms
@using Parrot.SharedComponents.Components.InputFields
@implements IDisposable

@if (_showToast)
{
    <div class="fp-toast">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" fill="#166534" stroke="none"/>
            <polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" fill="none"/>
        </svg>
        We've sent a password reset link to your email.
        <button class="fp-toast-close" @onclick="DismissToast">✕</button>
    </div>
}

<div class="fp-wrapper">
    @if (!_isSubmitted)
    {
        <div class="fp-card fp-card--mascot">
            <div class="fp-mascot">
                <img src="assets/images/gifs/owl-animation.gif" alt="Owl" />
            </div>
            <h1 class="fp-title">Reset your password</h1>
            <p class="fp-subtitle">Enter your email and we will send you a reset link.</p>

            <GenericForm Fields="@formFields"
                         SubmitButtonText="Send reset link"
                         OnSubmit="HandleSubmit"
                         PrimaryButton="true" />
        </div>
    }
    else
    {
        <div class="fp-card">
            <h1 class="fp-title">Check your email</h1>
            <p class="fp-check-body">
                We've sent a password reset link to your email address
                <a href="mailto:@_submittedEmail" class="fp-email-link">@_submittedEmail</a>.
                Follow the link to create a new password.
            </p>
            <p class="fp-check-hint">Didn't get the email? Check your spam folder or try again.</p>
            <button class="fp-btn-primary" @onclick="HandleResend">Resend email</button>
        </div>
    }

    <div class="fp-footer-pill">
        Remembered your password? <a href="/login">Sign in</a>
    </div>
</div>

@code {
    private bool _isSubmitted;
    private bool _showToast;
    private string _submittedEmail = string.Empty;
    private CancellationTokenSource _toastCts = new();

    private List<FormInputModel> formFields = new()
    {
        new FormInputModel
        {
            Id = "email",
            Label = "Email address",
            Type = "email",
            Placeholder = "you@example.com",
            ShowIcon = false
        }
    };

    private async Task HandleSubmit(Dictionary<string, string> formData)
    {
        _submittedEmail = formData.GetValueOrDefault("Email address", string.Empty);
        _isSubmitted = true;
        await ShowToastAsync();
    }

    private async Task ShowToastAsync()
    {
        _toastCts.Cancel();
        _toastCts = new CancellationTokenSource();
        _showToast = true;
        StateHasChanged();
        try
        {
            await Task.Delay(4000, _toastCts.Token);
            _showToast = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void DismissToast()
    {
        _toastCts.Cancel();
        _showToast = false;
    }

    private async Task HandleResend()
    {
        await ShowToastAsync();
    }

    public void Dispose()
    {
        _toastCts.Cancel();
        _toastCts.Dispose();
    }
}
