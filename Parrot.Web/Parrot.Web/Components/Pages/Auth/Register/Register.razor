@page "/register"
@layout AuthLayout
@using Parrot.SharedComponents.Components.Forms
@using Parrot.SharedComponents.Components.InputFields
@inject IRegisterService RegisterService
@inject RegisterState RegisterState
@inject NavigationManager Navigation
@implements IDisposable

<div class="register-wrapper">
    <div class="register-card">
        <div class="register-mascot">
            <img src="assets/images/gifs/owl-animation.gif" alt="Owl" />
        </div>
        <h1 class="register-title">Create your account</h1>
        <p class="register-subtitle">Set up your account to start handling customer messages with AI.</p>

        @if (!string.IsNullOrEmpty(RegisterState.ErrorMessage))
        {
            <div class="form-error-banner">@RegisterState.ErrorMessage</div>
        }

        <GenericForm Fields="@formFields"
                     SubmitButtonText="@(RegisterState.IsLoading ? "Creating account..." : "Create account")"
                     OnSubmit="HandleRegistration"
                     OnFieldChanged="HandleFieldChanged" />
    </div>

    <div class="register-footer-pill">
        Already have an account? <a href="/login">Sign in</a>
    </div>
</div>

@code {
    private List<FormInputModel> formFields = new()
    {
        new FormInputModel
        {
            Id = "businessName",
            Label = "Business name",
            Type = "text",
            Placeholder = "Oma's kitchen",
            ShowIcon = false
        },
        new FormInputModel
        {
            Id = "email",
            Label = "Email address",
            Type = "email",
            Placeholder = "you@example.com",
            ShowIcon = false
        },
        new FormInputModel
        {
            Id = "password",
            Label = "Password",
            Type = "password",
            Placeholder = "Create a secure password",
            ShowIcon = true,
            ShowPasswordStrength = true
        },
        new FormInputModel
        {
            Id = "confirmPassword",
            Label = "Confirm password",
            Type = "password",
            Placeholder = "Create a secure password",
            ShowIcon = true
        }
    };

    protected override void OnInitialized()
    {
        RegisterState.OnChange += StateHasChanged;
    }

    private void HandleFieldChanged((string FieldId, string Value) change)
    {
        if (change.FieldId == "password" || change.FieldId == "confirmPassword")
        {
            FormInputModel? passwordField = formFields.Find(f => f.Id == "password");
            FormInputModel? confirmField = formFields.Find(f => f.Id == "confirmPassword");

            if (passwordField != null && confirmField != null)
            {
                confirmField.ErrorMessage = (!string.IsNullOrEmpty(confirmField.Value) && passwordField.Value != confirmField.Value)
                    ? "Password mismatch"
                    : string.Empty;
            }
        }
    }

    private async Task HandleRegistration(Dictionary<string, string> formData)
    {
        RegisterState.Reset();

        string password = formData.GetValueOrDefault("Password", string.Empty);
        string confirmPassword = formData.GetValueOrDefault("Confirm password", string.Empty);

        if (password != confirmPassword)
        {
            RegisterState.SetError("Passwords do not match.");
            return;
        }

        RegisterState.SetLoading(true);

        try
        {
            await RegisterService.RegisterAsync(new RegisterRequest
            {
                BusinessName = formData.GetValueOrDefault("Business name", string.Empty),
                Email = formData.GetValueOrDefault("Email address", string.Empty),
                Password = password,
                ConfirmPassword = confirmPassword,
            });

            Navigation.NavigateTo("/verify-email");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            RegisterState.SetError("An account with this email already exists.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            RegisterState.SetError("Too many attempts. Please wait and try again.");
        }
        catch
        {
            RegisterState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            RegisterState.SetLoading(false);
        }
    }

    public void Dispose()
    {
        RegisterState.OnChange -= StateHasChanged;
    }
}
