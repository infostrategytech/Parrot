@page "/reset-password"
@layout AuthLayout
@using Parrot.SharedComponents.Components.Forms
@using Parrot.SharedComponents.Components.InputFields
@inject IResetPasswordService ResetPasswordService
@inject ResetPasswordState ResetPasswordState
@inject NavigationManager Navigation
@implements IDisposable

<div class="rp-wrapper">
    @if (!ResetPasswordState.IsSuccess)
    {
        <div class="rp-card">
            <div class="rp-mascot">
                <img src="assets/images/gifs/owl-animation.gif" alt="Owl" />
            </div>
            <h1 class="rp-title">Create a new password</h1>
            <p class="rp-subtitle">Set a new password you will remember.</p>

            @if (!string.IsNullOrEmpty(ResetPasswordState.ErrorMessage))
            {
                <div class="form-error-banner">@ResetPasswordState.ErrorMessage</div>
            }

            <GenericForm Fields="@formFields"
                         SubmitButtonText="@(ResetPasswordState.IsLoading ? "Resetting..." : "Reset password")"
                         OnSubmit="HandleReset"
                         OnFieldChanged="HandleFieldChanged"
                         PrimaryButton="true" />
        </div>
    }
    else
    {
        <div class="rp-card">
            <div class="rp-mascot">
                <img src="assets/images/gifs/owl-animation.gif" alt="Owl" />
            </div>
            <h1 class="rp-title">Password reset!</h1>
            <p class="rp-subtitle">Your password has been updated successfully.</p>
            <a href="/login" class="fp-btn-primary">Sign in</a>
        </div>
    }

    <div class="rp-footer-pill">
        Remembered your password? <a href="/login">Sign in</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private List<FormInputModel> formFields = new()
    {
        new FormInputModel
        {
            Id = "newPassword",
            Label = "New password",
            Type = "password",
            Placeholder = "Create a secure password",
            ShowIcon = true,
            ShowPasswordStrength = true
        },
        new FormInputModel
        {
            Id = "confirmPassword",
            Label = "Confirm new password",
            Type = "password",
            Placeholder = "Create a secure password",
            ShowIcon = true
        }
    };

    protected override void OnInitialized()
    {
        ResetPasswordState.OnChange += StateHasChanged;

        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
        {
            ResetPasswordState.SetError("Invalid or missing reset link. Please request a new one.");
        }
    }

    private void HandleFieldChanged((string FieldId, string Value) change)
    {
        if (change.FieldId == "newPassword" || change.FieldId == "confirmPassword")
        {
            FormInputModel? passwordField = formFields.Find(f => f.Id == "newPassword");
            FormInputModel? confirmField = formFields.Find(f => f.Id == "confirmPassword");

            if (passwordField != null && confirmField != null)
            {
                confirmField.ErrorMessage = (!string.IsNullOrEmpty(confirmField.Value) && passwordField.Value != confirmField.Value)
                    ? "Password mismatch"
                    : string.Empty;
            }
        }
    }

    private async Task HandleReset(Dictionary<string, string> formData)
    {
        ResetPasswordState.Reset();

        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Token))
        {
            ResetPasswordState.SetError("Invalid or missing reset link. Please request a new one.");
            return;
        }

        string newPassword = formData.GetValueOrDefault("New password", string.Empty);
        string confirmPassword = formData.GetValueOrDefault("Confirm new password", string.Empty);

        if (newPassword != confirmPassword)
        {
            ResetPasswordState.SetError("Passwords do not match.");
            return;
        }

        ResetPasswordState.SetLoading(true);

        try
        {
            await ResetPasswordService.ResetPasswordAsync(new ResetPasswordRequest
            {
                UserId = UserId,
                Token = Token,
                NewPassword = newPassword,
                ConfirmNewPassword = confirmPassword,
            });

            ResetPasswordState.SetSuccess();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            ResetPasswordState.SetError("Invalid or expired reset link. Please request a new one.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            ResetPasswordState.SetError("Account not found. Please request a new reset link.");
        }
        catch
        {
            ResetPasswordState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            ResetPasswordState.SetLoading(false);
        }
    }

    public void Dispose()
    {
        ResetPasswordState.OnChange -= StateHasChanged;
    }
}
