@page "/"
@page "/login"
@layout AuthLayout
@using Parrot.SharedComponents.Components.Forms
@using Parrot.SharedComponents.Components.InputFields
@inject ILoginService LoginService
@inject AuthState AuthState
@inject LoginState LoginState
@inject TokenStorageService TokenStorage
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-mascot">
            <img src="assets/images/gifs/owl-animation.gif" alt="Owl" />
        </div>
        <h1 class="login-title">Welcome Back</h1>
        <p class="login-subtitle">Sign in to manage your business AI agents.</p>

        @if (!string.IsNullOrEmpty(LoginState.ErrorMessage))
        {
            <div class="form-error-banner">@LoginState.ErrorMessage</div>
        }

        <GenericForm Fields="@formFields"
                     SubmitButtonText="@(LoginState.IsLoading ? "Signing in..." : "Sign in")"
                     OnSubmit="HandleLogin"
                     OnFieldChanged="HandleFieldChanged">
            <AdditionalContent>
                <label class="login-checkbox">
                    <input type="checkbox" @bind="_keepSignedIn" />
                    Keep me signed in
                </label>
            </AdditionalContent>
        </GenericForm>

        <div class="login-divider">
            <span>or</span>
        </div>

        <a href="@_apiBaseUrl/api/auth/sso/google" class="login-sso-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Continue with Google
        </a>
    </div>

    <div class="login-footer-pill">
        Don't have an account? <a href="/register">Create account</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? error { get; set; }

    private bool _keepSignedIn;
    private string _apiBaseUrl = string.Empty;

    private List<FormInputModel> formFields = new()
    {
        new FormInputModel
        {
            Id = "email",
            Label = "Email address",
            Type = "email",
            Placeholder = "you@example.com",
            ShowIcon = false
        },
        new FormInputModel
        {
            Id = "password",
            Label = "Password",
            Type = "password",
            Placeholder = "Enter your secure password",
            ShowIcon = true,
            LabelLinkText = "Forgot password?",
            LabelLinkHref = "/forgot-password"
        }
    };

    protected override void OnInitialized()
    {
        _apiBaseUrl = (Configuration["ApiSettings:BaseUrl"] ?? string.Empty).TrimEnd('/');
        LoginState.OnChange += StateHasChanged;

        if (!string.IsNullOrEmpty(error))
        {
            LoginState.SetError("Google sign-in failed. Please try again or use email and password.");
        }
    }

    private void HandleFieldChanged((string FieldId, string Value) change) { }

    private async Task HandleLogin(Dictionary<string, string> formData)
    {
        LoginState.Reset();
        LoginState.SetLoading(true);

        try
        {
            string email = formData.GetValueOrDefault("Email address", string.Empty);
            string password = formData.GetValueOrDefault("Password", string.Empty);

            AuthResponse? response = await LoginService.LoginAsync(new LoginRequest
            {
                Email = email,
                Password = password,
            });

            if (response is not null)
            {
                AuthState.SetUser(response);
                await TokenStorage.SaveAsync(response);
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            LoginState.SetError("Invalid email or password.");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            LoginState.SetError("Too many attempts. Please wait and try again.");
        }
        catch
        {
            LoginState.SetError("Something went wrong. Please try again.");
        }
        finally
        {
            LoginState.SetLoading(false);
        }
    }

    public void Dispose()
    {
        LoginState.OnChange -= StateHasChanged;
    }
}
