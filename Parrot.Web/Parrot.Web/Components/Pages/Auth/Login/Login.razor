@page "/"
@page "/login"
@layout AuthLayout
@using Parrot.SharedComponents.Components.Forms
@using Parrot.SharedComponents.Components.InputFields

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-mascot">
            <img src="assets/images/gifs/owl-animation.gif" alt="Owl" />
        </div>
        <h1 class="login-title">Welcome Back</h1>
        <p class="login-subtitle">Sign in to manage your business AI agents.</p>

        <GenericForm Fields="@formFields"
                     SubmitButtonText="Sign in"
                     OnSubmit="HandleLogin"
                     OnFieldChanged="HandleFieldChanged">
            <AdditionalContent>
                <label class="login-checkbox">
                    <input type="checkbox" @bind="_keepSignedIn" />
                    Keep me signed in
                </label>
            </AdditionalContent>
        </GenericForm>
    </div>

    <div class="login-footer-pill">
        Don't have an account? <a href="/register">Create account</a>
    </div>
</div>

@code {
    private bool _keepSignedIn;

    private List<FormInputModel> formFields = new()
    {
        new FormInputModel
        {
            Id = "email",
            Label = "Email address",
            Type = "email",
            Placeholder = "you@example.com",
            ShowIcon = false
        },
        new FormInputModel
        {
            Id = "password",
            Label = "Password",
            Type = "password",
            Placeholder = "Enter your secure password",
            ShowIcon = true,
            LabelLinkText = "Forgot password?",
            LabelLinkHref = "/forgot-password"
        }
    };

    private void HandleFieldChanged((string FieldId, string Value) change) { }

    private async Task HandleLogin(Dictionary<string, string> formData)
    {
        await Task.CompletedTask;
    }
}
