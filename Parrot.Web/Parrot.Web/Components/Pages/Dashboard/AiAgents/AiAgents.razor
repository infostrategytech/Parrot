@page "/dashboard/ai-agents"
@layout DashboardLayout
@inject AiAgentsState AiAgentsState
@inject NavigationManager Nav
@using Parrot.Web.Components.Pages.Dashboard.AiAgents

<div class="aia-page">
    @if (!AiAgentsState.Agents.Any())
    {
        <div class="aia-empty">
            <div class="aia-empty-bg-img"></div>
            <div class="aia-empty-content">
                <img src="/assets/images/gifs/owl-animation.gif" alt="Owl mascot" class="aia-empty-owl-img" />
                <h2 class="aia-empty-title">Meet your AI workforce</h2>
                <p class="aia-empty-sub">Start by creating an AI agent to handle conversations<br />and routine requests for
                    you.</p>
                    <button class="aia-btn-primary" @onclick="() => _showCreate = true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="16" />
                            <line x1="8" y1="12" x2="16" y2="12" />
                        </svg>
                        Create Ai Agent
                    </button>
                </div>
            </div>
        }
    else
        {
            <div class="aia-list-header">
                <button class="aia-btn-primary" @onclick="() => _showCreate = true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="16" />
                        <line x1="8" y1="12" x2="16" y2="12" />
                    </svg>
                    Create AI agent
                </button>
            </div>
            <div class="aia-grid">
                @foreach (var agent in AiAgentsState.Agents)
                {
                    var agentId = agent.Id;
                    <div class="aia-card @(_hoveredId == agentId ? "aia-card--hover" : "")"
                         @onmouseenter="() => _hoveredId = agentId" @onmouseleave="() => _hoveredId = string.Empty"
                         @onclick="() => GoToAgent(agentId)">
                        <div class="aia-card-top">
                            <img src="@GetMascotGif(agent.Mascot)" alt="@agent.Mascot" class="aia-mascot-sm-img" />
                            <div class="aia-card-info">
                                <span class="aia-card-name">@agent.Name</span>
                                <div class="aia-card-status">
                                    <span class="aia-status-dot"></span>
                                    <span>Active</span>
                                </div>
                            </div>
                            @if (_hoveredId == agentId)
                            {
                                <div class="aia-card-actions" @onclick:stopPropagation>
                                    <button class="aia-action-btn" title="Edit"
                                            @onclick="() => { _editAgent = agent; _showCreate = true; }">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </button>
                                    <button class="aia-action-btn" title="View" @onclick="() => GoToAgent(agentId)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="3" />
                                            <path
                                            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                                        </svg>
                                    </button>
                                    <button class="aia-action-btn aia-action-btn--del" title="Delete"
                                            @onclick="() => AiAgentsState.RemoveAgent(agentId)">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                            <path d="M10 11v6" />
                                            <path d="M14 11v6" />
                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                        <p class="aia-card-desc">@agent.Description</p>
                        <div class="aia-card-stats">
                            <div class="aia-stat">
                                <span class="aia-stat-label">Playbook</span>
                                <span class="aia-stat-val">@agent.PlaybookCount</span>
                            </div>
                            <div class="aia-stat">
                                <span class="aia-stat-label">Channels</span>
                                <span class="aia-stat-val">@agent.ChannelCount</span>
                            </div>
                            <div class="aia-stat">
                                <span class="aia-stat-label">Messages Today</span>
                                <span class="aia-stat-val">@agent.MessagesToday</span>
                            </div>
                        </div>
                        <div class="aia-card-divider"></div>
                        <button type="button" class="aia-orientation-btn" @onclick:stopPropagation
                                @onclick="() => GoToOrientation(agentId)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="3 11 22 2 13 21 11 13 3 11" />
                            </svg>
                            Give Orientation
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @if (_showCreate)
    {
        <CreateAgentModal OnCancel="CloseModal" OnCreate="HandleCreate" />
    }

@code {
    private bool _showCreate;
    private string _hoveredId = string.Empty;
    private AiAgent? _editAgent;

    private void CloseModal()
    {
        _showCreate = false;
        _editAgent = null;
    }

    private void HandleCreate(AiAgent agent)
    {
        AiAgentsState.AddAgent(agent);
        _showCreate = false;
        _editAgent = null;
    }

    private void GoToAgent(string id) => Nav.NavigateTo($"/dashboard/ai-agents/{id}");
    private void GoToOrientation(string id) => Nav.NavigateTo($"/dashboard/ai-agents/{id}/orientation");

    private static string GetMascotGif(string mascot) => mascot switch
    {
        "Atlas" => "/assets/images/avatars/avatar-2.png",
        "Bolt" => "/assets/images/avatars/avatar-3.png",
        "Aegis" => "/assets/images/avatars/avatar-4.png",
        "Buzz" => "/assets/images/avatars/avatar-5.png",
        "Luna" => "/assets/images/avatars/avatar-6.png",
        _ => "/assets/images/avatars/avatar-1.png"
    };
}
