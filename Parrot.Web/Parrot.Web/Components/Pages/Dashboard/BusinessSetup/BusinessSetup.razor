@page "/dashboard/business-setup"
@layout Parrot.Web.Components.Layout.Dashboard.DashboardLayout
@namespace Parrot.Web.Components.Pages.Dashboard.BusinessSetup
@using Parrot.Web.Components.Pages.Dashboard.AiAgents
@using Parrot.Web.Components.Pages.Dashboard.BusinessSetup.Services
@using Parrot.Web.Features.Auth.State
@inject NavigationManager Nav
@inject IBusinessSetupService BusinessSetupService
@inject AuthState AuthState

<div class="bs-page">

    <!-- Header -->
    <div class="bs-header">
        <button class="bs-back" @onclick='() => Nav.NavigateTo("/dashboard")'>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Back to Dashboard
        </button>
        <div class="bs-header-text">
            <h1 class="bs-title">Business Setup</h1>
            <p class="bs-subtitle">Get your organization up and running in two quick steps.</p>
        </div>
    </div>

    <!-- Step indicators -->
    <div class="bs-steps">
        @for (int i = 1; i <= 3; i++)
        {
            var step = i;
            var isActive  = _step == step;
            var isDone    = _step > step || _done;
            <div class="bs-step @(isActive ? "bs-step--active" : "") @(isDone ? "bs-step--done" : "")">
                <div class="bs-step-circle">
                    @if (isDone && !isActive)
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.6"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    }
                    else
                    {
                        @step
                    }
                </div>
                <div class="bs-step-label">@GetStepLabel(step)</div>
            </div>
            @if (i < 3)
            {
                <div class="bs-step-line @(_step > step || _done ? "bs-step-line--done" : "")"></div>
            }
        }
    </div>

    <!-- ── STEP 1: Business Information ── -->
    @if (_step == 1)
    {
        <div class="bs-card bs-rise">
            <div class="bs-card-header">
                <div class="bs-card-icon bs-card-icon--purple">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                </div>
                <div>
                    <h2 class="bs-card-title">Organization Details</h2>
                    <p class="bs-card-sub">Tell us about your business so we can personalize your workspace.</p>
                </div>
            </div>

            <div class="bs-form">

                <div class="bs-row">
                    <div class="bs-field">
                        <label class="bs-label">Organization name <span class="bs-req">*</span></label>
                        <input class="bs-input @(_showErrors && string.IsNullOrWhiteSpace(_org.Name) ? "bs-input--error" : "")"
                               placeholder="e.g. iBakers Ltd."
                               @bind="_org.Name" @bind:event="oninput" />
                        @if (_showErrors && string.IsNullOrWhiteSpace(_org.Name))
                        {
                            <span class="bs-error">Organization name is required.</span>
                        }
                    </div>

                    <div class="bs-field">
                        <label class="bs-label">Industry <span class="bs-req">*</span></label>
                        <div class="bs-select-wrap">
                            <select class="bs-select @(_showErrors && string.IsNullOrWhiteSpace(_org.Industry) ? "bs-input--error" : "")"
                                    value="@_org.Industry" @onchange='e => _org.Industry = e.Value?.ToString() ?? ""'>
                                <option value="">-- Select industry --</option>
                                @foreach (var ind in BusinessIndustries.All)
                                {
                                    <option value="@ind">@ind</option>
                                }
                            </select>
                            <svg class="bs-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                        </div>
                        @if (_showErrors && string.IsNullOrWhiteSpace(_org.Industry))
                        {
                            <span class="bs-error">Industry is required.</span>
                        }
                    </div>
                </div>

                <div class="bs-row">
                    <div class="bs-field">
                        <label class="bs-label">Business size</label>
                        <div class="bs-select-wrap">
                            <select class="bs-select" value="@_org.Size"
                                    @onchange='e => _org.Size = e.Value?.ToString() ?? ""'>
                                <option value="">-- Select size --</option>
                                @foreach (var sz in BusinessSizes.All)
                                {
                                    <option value="@sz">@sz</option>
                                }
                            </select>
                            <svg class="bs-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                        </div>
                    </div>

                    <div class="bs-field">
                        <label class="bs-label">Country / Region</label>
                        <div class="bs-select-wrap">
                            <select class="bs-select" value="@_org.Country"
                                    @onchange='e => _org.Country = e.Value?.ToString() ?? ""'>
                                <option value="">-- Select country --</option>
                                @foreach (var c in _countries)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                            <svg class="bs-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                        </div>
                    </div>
                </div>

                <div class="bs-field">
                    <label class="bs-label">Business description
                        <span class="bs-optional">(Optional)</span>
                    </label>
                    <textarea class="bs-textarea" rows="3"
                              placeholder="Brief overview of what your business does and who you serve…"
                              @bind="_org.Description" @bind:event="oninput"></textarea>
                </div>

                <div class="bs-row">
                    <div class="bs-field">
                        <label class="bs-label">Business email</label>
                        <input class="bs-input" type="email" placeholder="hello@yourbusiness.com"
                               @bind="_org.BusinessEmail" @bind:event="oninput" />
                    </div>
                    <div class="bs-field">
                        <label class="bs-label">Phone number</label>
                        <input class="bs-input" type="tel" placeholder="+234 800 000 0000"
                               @bind="_org.PhoneNumber" @bind:event="oninput" />
                    </div>
                </div>

                <div class="bs-field">
                    <label class="bs-label">Website</label>
                    <input class="bs-input" type="url" placeholder="https://yourbusiness.com"
                           @bind="_org.Website" @bind:event="oninput" />
                </div>

                <!-- Social media section -->
                <div class="bs-social-section">
                    <button type="button" class="bs-social-toggle" @onclick="() => _showSocial = !_showSocial">
                        <div class="bs-social-toggle-left">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#53279E" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
                            </svg>
                            <span class="bs-social-toggle-label">Social Media Presence</span>
                            <span class="bs-optional">(Optional)</span>
                        </div>
                        <svg class="bs-social-chevron @(_showSocial ? "bs-social-chevron--open" : "")"
                             width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="2">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>

                    @if (_showSocial)
                    {
                        <div class="bs-social-grid bs-rise">

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--facebook">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
                                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                                        </svg>
                                    </span>
                                    Facebook
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">facebook.com/</span>
                                    <input class="bs-social-input" placeholder="yourpage"
                                           @bind="_org.SocialMedia.Facebook" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--instagram">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                                             stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                                            <circle cx="12" cy="12" r="4" />
                                            <circle cx="17.5" cy="6.5" r="1" fill="white" stroke="none" />
                                        </svg>
                                    </span>
                                    Instagram
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">@@</span>
                                    <input class="bs-social-input" placeholder="youraccount"
                                           @bind="_org.SocialMedia.Instagram" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--twitter">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
                                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                                        </svg>
                                    </span>
                                    X (Twitter)
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">@@</span>
                                    <input class="bs-social-input" placeholder="yourhandle"
                                           @bind="_org.SocialMedia.TwitterX" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--linkedin">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
                                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" />
                                            <circle cx="4" cy="4" r="2" />
                                        </svg>
                                    </span>
                                    LinkedIn
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">linkedin.com/company/</span>
                                    <input class="bs-social-input" placeholder="yourcompany"
                                           @bind="_org.SocialMedia.LinkedIn" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--whatsapp">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
                                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                                        </svg>
                                    </span>
                                    WhatsApp Business
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">+</span>
                                    <input class="bs-social-input" placeholder="234 800 000 0000"
                                           @bind="_org.SocialMedia.WhatsApp" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--youtube">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
                                            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z" />
                                            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#DC2626" />
                                        </svg>
                                    </span>
                                    YouTube
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">youtube.com/@@</span>
                                    <input class="bs-social-input" placeholder="yourchannel"
                                           @bind="_org.SocialMedia.YouTube" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="bs-social-field">
                                <div class="bs-social-label">
                                    <span class="bs-social-icon bs-social-icon--tiktok">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="white">
                                            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.16 8.16 0 0 0 4.77 1.52V6.76a4.86 4.86 0 0 1-1-.07z" />
                                        </svg>
                                    </span>
                                    TikTok
                                </div>
                                <div class="bs-social-input-wrap">
                                    <span class="bs-social-prefix">@@</span>
                                    <input class="bs-social-input" placeholder="youraccount"
                                           @bind="_org.SocialMedia.TikTok" @bind:event="oninput" />
                                </div>
                            </div>

                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- Preliminary info banner -->
        <div class="bs-info-banner">
            <div class="bs-info-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#53279E" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </div>
            <p class="bs-info-text">
                Your business details help personalize AI responses, set your workspace timezone, and let agents greet
                customers with the right context. You can update these anytime from <strong>Settings → Workspace</strong>.
            </p>
        </div>

        <div class="bs-footer">
            <button class="bs-btn bs-btn--ghost" @onclick='() => Nav.NavigateTo("/dashboard")'>Cancel</button>
            <button class="bs-btn bs-btn--primary" @onclick="GoToStep2" disabled="@_enriching">
                @if (_enriching)
                {
                    <span class="bs-spinner"></span>
                    <span>Pulling context from your website & socials…</span>
                }
                else
                {
                    <span>Continue — Review Profile</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                }
            </button>
        </div>
    }

    <!-- ── STEP 2: Review Business Profile ── -->
    @if (_step == 2)
    {
        <div class="bs-card bs-rise">
            <div class="bs-card-header">
                <div class="bs-card-icon bs-card-icon--purple">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3v3m0 12v3m9-9h-3M6 12H3m15.5-6.5l-2 2m-11 11l-2 2m0-15l2 2m11 11l2 2" />
                        <circle cx="12" cy="12" r="4" />
                    </svg>
                </div>
                <div>
                    <h2 class="bs-card-title">Review Business Profile</h2>
                    <p class="bs-card-sub">We pulled this from @_org.Name's website and social profiles. Check it over and edit anything before continuing.</p>
                </div>
            </div>

            @if (_enrichmentResult is not null && (_enrichmentResult.SourcesUsed.Count > 0 || _enrichmentResult.Warnings.Count > 0))
            {
                <div class="bs-enrich-meta">
                    @if (_enrichmentResult.SourcesUsed.Count > 0)
                    {
                        <p class="bs-enrich-sources">
                            <strong>Pulled from:</strong> @string.Join(", ", _enrichmentResult.SourcesUsed)
                        </p>
                    }
                    @foreach (var warning in _enrichmentResult.Warnings)
                    {
                        <p class="bs-enrich-warning">@warning</p>
                    }
                </div>
            }

            <div class="bs-form">

                <div class="bs-field">
                    <label class="bs-label">Business description</label>
                    <textarea class="bs-textarea" rows="3"
                              placeholder="Brief overview of what your business does and who it serves…"
                              @bind="_org.Description" @bind:event="oninput"></textarea>
                </div>

                <div class="bs-row">
                    <div class="bs-field">
                        <label class="bs-label">Industry</label>
                        <div class="bs-select-wrap">
                            <select class="bs-select" value="@_org.Industry" @onchange='e => _org.Industry = e.Value?.ToString() ?? ""'>
                                <option value="">-- Select industry --</option>
                                @foreach (var ind in BusinessIndustries.All)
                                {
                                    <option value="@ind">@ind</option>
                                }
                            </select>
                            <svg class="bs-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_enrichmentResult?.SuggestedIndustry) && _enrichmentResult.SuggestedIndustry != _org.Industry)
                        {
                            <button type="button" class="bs-suggestion" @onclick="() => _org.Industry = _enrichmentResult.SuggestedIndustry">
                                AI suggests "@_enrichmentResult.SuggestedIndustry" — use this
                            </button>
                        }
                    </div>

                    <div class="bs-field">
                        <label class="bs-label">Business size</label>
                        <div class="bs-select-wrap">
                            <select class="bs-select" value="@_org.Size" @onchange='e => _org.Size = e.Value?.ToString() ?? ""'>
                                <option value="">-- Select size --</option>
                                @foreach (var sz in BusinessSizes.All)
                                {
                                    <option value="@sz">@sz</option>
                                }
                            </select>
                            <svg class="bs-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_enrichmentResult?.SuggestedSize) && _enrichmentResult.SuggestedSize != _org.Size)
                        {
                            <button type="button" class="bs-suggestion" @onclick="() => _org.Size = _enrichmentResult.SuggestedSize">
                                AI suggests "@_enrichmentResult.SuggestedSize" — use this
                            </button>
                        }
                    </div>
                </div>

                <div class="bs-field">
                    <label class="bs-label">Brand voice <span class="bs-optional">(Optional)</span></label>
                    <input class="bs-input" placeholder="e.g. friendly and casual, professional and concise…"
                           @bind="_org.BrandVoice" @bind:event="oninput" />
                </div>

                @if (_org.KeyFacts.Count > 0)
                {
                    <div class="bs-field">
                        <label class="bs-label">Key facts</label>
                        <ul class="bs-fact-list">
                            @foreach (var fact in _org.KeyFacts.ToList())
                            {
                                <li class="bs-fact-chip">
                                    <span>@fact</span>
                                    <button type="button" class="bs-fact-remove" @onclick="() => _org.KeyFacts.Remove(fact)">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                                             stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="bs-field">
                    <label class="bs-label">Additional context
                        <span class="bs-optional">(Optional)</span>
                    </label>
                    <textarea class="bs-textarea" rows="3"
                              placeholder="Anything else your agents should know — promotions, policies, FAQs, tone guidance…"
                              @bind="_org.ExtraContext" @bind:event="oninput"></textarea>
                </div>

            </div>
        </div>

        <div class="bs-footer">
            <button class="bs-btn bs-btn--ghost" @onclick="() => _step = 1">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 5l-7 7 7 7" />
                </svg>
                Back
            </button>
            <button class="bs-btn bs-btn--primary" @onclick="() => _step = 3">
                Continue — Employ Agents
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    }

    <!-- ── STEP 3: Employ Agents ── -->
    @if (_step == 3)
    {
        <div class="bs-card bs-rise">
            <div class="bs-card-header">
                <div class="bs-card-icon bs-card-icon--indigo">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <div>
                    <h2 class="bs-card-title">Employ Agents under <span class="bs-org-name">@_org.Name</span></h2>
                    <p class="bs-card-sub">Assign AI agents to handle conversations for this organization. You can add more later.</p>
                </div>
            </div>

            <!-- Agent grid -->
            <div class="bs-agent-grid">
                @foreach (var agent in _availableAgents)
                {
                    var a = agent;
                    var isSelected = _selectedAgentIds.Contains(a.Id);
                    <div class="bs-agent-card @(isSelected ? "bs-agent-card--selected" : "")"
                         @onclick="() => ToggleAgent(a.Id)">
                        <div class="bs-agent-check @(isSelected ? "bs-agent-check--on" : "")">
                            @if (isSelected)
                            {
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                            }
                        </div>
                        <img src="/assets/images/avatars/avatar-@(GetAvatarIndex(a.Mascot)).png"
                             alt="@a.Mascot" class="bs-agent-avatar" />
                        <div class="bs-agent-info">
                            <p class="bs-agent-name">@a.Name</p>
                            <p class="bs-agent-mascot">@a.Mascot</p>
                        </div>
                        <span class="bs-agent-status @(a.IsActive ? "bs-agent-status--live" : "")">
                            @(a.IsActive ? "Live" : "Draft")
                        </span>
                    </div>
                }

                <!-- Create new agent tile -->
                <button class="bs-agent-new" @onclick="CreateNewAgent">
                    <div class="bs-agent-new-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#53279E" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                    </div>
                    <p class="bs-agent-new-label">Create new agent</p>
                </button>
            </div>

            <!-- Role assignment for selected agents -->
            @if (_selectedAgentIds.Count > 0)
            {
                <div class="bs-role-section">
                    <h3 class="bs-role-title">Assign roles</h3>
                    <p class="bs-role-sub">Define what each agent is responsible for within this organization.</p>
                    <div class="bs-role-list">
                        @foreach (var id in _selectedAgentIds)
                        {
                            var agentId = id;
                            var agentName = _availableAgents.FirstOrDefault(a => a.Id == agentId)?.Name ?? agentId;
                            if (!_agentRoles.ContainsKey(agentId)) _agentRoles[agentId] = string.Empty;
                            <div class="bs-role-row">
                                <div class="bs-role-agent-name">
                                    <span class="bs-role-dot"></span>
                                    @agentName
                                </div>
                                <div class="bs-select-wrap bs-role-select-wrap">
                                    <select class="bs-select"
                                            value="@_agentRoles[agentId]"
                                            @onchange='e => _agentRoles[agentId] = e.Value?.ToString() ?? ""'>
                                        <option value="">-- Choose role --</option>
                                        @foreach (var role in AgentRoles.All)
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    </select>
                                    <svg class="bs-select-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="bs-empty-agents @(_selectedAgentIds.Count > 0 ? "bs-hidden" : "")">
                <p>Select one or more agents above to assign them to <strong>@_org.Name</strong>.</p>
                <p class="bs-empty-agents-hint">You can also skip this step and add agents later from the AI Agents page.</p>
            </div>
        </div>

        <div class="bs-footer">
            <button class="bs-btn bs-btn--ghost" @onclick="() => _step = 2">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 5l-7 7 7 7" />
                </svg>
                Back
            </button>
            <div class="bs-footer-right">
                <button class="bs-btn bs-btn--outline" @onclick="SkipAndFinish">Skip for now</button>
                <button class="bs-btn bs-btn--primary" @onclick="Finish" disabled="@(_selectedAgentIds.Count == 0)">
                    @if (_saving)
                    {
                        <span class="bs-spinner"></span>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <span>Finish Setup</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    }
                </button>
            </div>
        </div>
    }

    <!-- ── SUCCESS STATE ── -->
    @if (_done)
    {
        <div class="bs-success bs-rise">
            <div class="bs-success-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>
            <h2 class="bs-success-title">@_org.Name is ready!</h2>
            <p class="bs-success-sub">
                Your organization has been set up@(_org.EmployedAgents.Count > 0
                    ? $" with {_org.EmployedAgents.Count} agent{(_org.EmployedAgents.Count == 1 ? "" : "s")} employed"
                    : "").
                Head to the dashboard or start managing your agents.
            </p>
            <div class="bs-success-actions">
                <a href="/dashboard" class="bs-btn bs-btn--outline">Go to Dashboard</a>
                <a href="/dashboard/ai-agents" class="bs-btn bs-btn--primary">View AI Agents</a>
            </div>
        </div>
    }

</div>

@code {
    private int _step = 1;
    private bool _done;
    private bool _saving;
    private bool _showErrors;
    private bool _showSocial;
    private bool _enriching;
    private BusinessEnrichmentResult? _enrichmentResult;

    private BusinessOrganization _org = new();
    private HashSet<string> _selectedAgentIds = new();
    private Dictionary<string, string> _agentRoles = new();

    private readonly List<AiAgent> _availableAgents = new()
    {
        new AiAgent { Id = "1", Name = "Bakerbot",  Mascot = "Nova",  IsActive = true,  MessagesToday = 38 },
        new AiAgent { Id = "2", Name = "SalesBot",  Mascot = "Atlas", IsActive = true,  MessagesToday = 12 },
        new AiAgent { Id = "3", Name = "SupportAI", Mascot = "Bolt",  IsActive = false, MessagesToday = 0  },
        new AiAgent { Id = "4", Name = "LeadGen",   Mascot = "Aegis", IsActive = true,  MessagesToday = 7  },
        new AiAgent { Id = "5", Name = "Buzzy",     Mascot = "Buzz",  IsActive = false, MessagesToday = 0  },
        new AiAgent { Id = "6", Name = "LunaBot",   Mascot = "Luna",  IsActive = true,  MessagesToday = 21 },
    };

    private static readonly string[] _countries =
    [
        "Nigeria", "Ghana", "Kenya", "South Africa", "United States", "United Kingdom",
        "Canada", "Australia", "India", "Germany", "France", "Brazil", "Singapore", "Other"
    ];

    private static string GetStepLabel(int step) => step switch
    {
        1 => "Business Info",
        2 => "Review Profile",
        _ => "Employ Agents",
    };

    private async Task GoToStep2()
    {
        _showErrors = true;
        if (string.IsNullOrWhiteSpace(_org.Name) || string.IsNullOrWhiteSpace(_org.Industry))
            return;
        _showErrors = false;

        string? token = AuthState.CurrentUser?.Token;
        if (!string.IsNullOrEmpty(token) && HasAnyEnrichmentSource())
        {
            _enriching = true;
            StateHasChanged();

            try
            {
                BusinessEnrichmentRequest request = new()
                {
                    Website = _org.Website,
                    Facebook = _org.SocialMedia.Facebook,
                    Instagram = _org.SocialMedia.Instagram,
                    TwitterX = _org.SocialMedia.TwitterX,
                    LinkedIn = _org.SocialMedia.LinkedIn,
                    YouTube = _org.SocialMedia.YouTube,
                    TikTok = _org.SocialMedia.TikTok,
                };

                _enrichmentResult = await BusinessSetupService.EnrichAsync(request, token);
                ApplyEnrichmentResult();
            }
            catch (Exception)
            {
                _enrichmentResult = new BusinessEnrichmentResult
                {
                    Warnings = { "Couldn't reach the enrichment service — you can still fill this in manually." },
                };
            }
            finally
            {
                _enriching = false;
            }
        }

        _step = 2;
    }

    private bool HasAnyEnrichmentSource() =>
        !string.IsNullOrWhiteSpace(_org.Website) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.Facebook) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.Instagram) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.TwitterX) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.LinkedIn) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.YouTube) ||
        !string.IsNullOrWhiteSpace(_org.SocialMedia.TikTok);

    private void ApplyEnrichmentResult()
    {
        if (_enrichmentResult is null)
            return;

        if (string.IsNullOrWhiteSpace(_org.Description) && !string.IsNullOrWhiteSpace(_enrichmentResult.Description))
            _org.Description = _enrichmentResult.Description;

        _org.BrandVoice = _enrichmentResult.BrandVoice;
        _org.KeyFacts = new List<string>(_enrichmentResult.KeyFacts);
    }

    private void ToggleAgent(string id)
    {
        if (!_selectedAgentIds.Add(id))
            _selectedAgentIds.Remove(id);
    }

    private void CreateNewAgent() => Nav.NavigateTo("/dashboard/ai-agents");

    private static int GetAvatarIndex(string mascot) => mascot switch
    {
        "Nova"  => 1, "Atlas" => 2, "Bolt" => 3,
        "Aegis" => 4, "Buzz"  => 5, "Luna" => 6,
        _ => 1
    };

    private async Task Finish()
    {
        _saving = true;
        StateHasChanged();
        await Task.Delay(800);

        foreach (var id in _selectedAgentIds)
        {
            var agent = _availableAgents.FirstOrDefault(a => a.Id == id);
            if (agent is null) continue;
            _org.EmployedAgents.Add(new EmployedAgent
            {
                AgentId   = id,
                AgentName = agent.Name,
                Mascot    = agent.Mascot,
                Role      = _agentRoles.TryGetValue(id, out var r) ? r : string.Empty
            });
        }

        _saving = false;
        _done   = true;
    }

    private void SkipAndFinish() => _done = true;
}
