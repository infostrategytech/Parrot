@page "/dashboard/channels"
@layout DashboardLayout
@inject ChannelsState ChannelsState
@inject NavigationManager Nav

<div class="channels-page">
    <div class="channels-info-banner">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <span>Your credentials are encrypted and stored securely using industry-standard protocols.</span>
    </div>

    <div class="channels-grid">
        @foreach (var channel in ChannelsState.Channels)
        {
            <div class="channel-card">
                <div class="channel-card-header">
                    @if (channel.Key == "twitter")
                    {
                        <div class="channel-card-icon channel-card-icon--twitter">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631Zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                        </div>
                    }
                    else
                    {
                        <img src="@channel.IconPath" alt="@channel.Name" class="channel-card-icon" />
                    }
                    <div
                        class="channel-card-status @(channel.Status == ChannelStatus.Connected ? "channel-card-status--connected" : "")">
                        <span class="channel-status-dot"></span>
                        <span>@(channel.Status == ChannelStatus.Connected ? "Connected" : "Not connected")</span>
                    </div>
                </div>
                <h3 class="channel-card-name">@channel.Name</h3>
                <p class="channel-card-desc">@channel.Description</p>
                <div class="channel-card-meta">
                    <div class="channel-card-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="2" y1="12" x2="22" y2="12" />
                            <path
                            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                        </svg>
                        <span>@(channel.PhoneNumber ?? "N/A")</span>
                    </div>
                    <div class="channel-card-meta-item">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                        <span>@(channel.ConnectedDate ?? "--")</span>
                    </div>
                </div>
                @if (channel.Status == ChannelStatus.Connected)
                {
                    <button class="channel-card-btn channel-card-btn--disconnect" @onclick="() => OpenDisconnect(channel.Key)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Disconnect account
                    </button>
                }
                else
                {
                    <button class="channel-card-btn" @onclick="() => OpenConnect(channel.Key)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                            <polyline points="15 3 21 3 21 9" />
                            <line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                        Connect account
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (_showConnectModal)
{
    <ConnectWhatsappModal OnCancel="CloseConnect" OnStartSetup="StartSetup" />
}

@if (_showDisconnectModal)
{
    <DisconnectConfirmModal Visible="true" OnCancel="CloseDisconnect" OnConfirm="ConfirmDisconnect" />
}

@code {
    private bool _showConnectModal;
    private bool _showDisconnectModal;
    private string _activeChannelKey = string.Empty;

    private void OpenConnect(string key)
    {
        if (key == "whatsapp")
        {
            _activeChannelKey = key;
            _showConnectModal = true;
        }
    }

    private void CloseConnect() => _showConnectModal = false;

    private void StartSetup()
    {
        _showConnectModal = false;
        Nav.NavigateTo("/dashboard/channels/connect-whatsapp");
    }

    private void OpenDisconnect(string key)
    {
        _activeChannelKey = key;
        _showDisconnectModal = true;
    }

    private void CloseDisconnect() => _showDisconnectModal = false;

    private void ConfirmDisconnect()
    {
        ChannelsState.DisconnectChannel(_activeChannelKey);
        _showDisconnectModal = false;
    }
}
