@namespace Parrot.Web.Components.Pages.Dashboard.Channels

<ModalShell Visible="true" Title="Connect whatsApp business"
            Subtitle="Follow the steps below to securely connect your WhatsApp Business account."
            Size="md" ShowCloseButton="false" ShowDivider="true" OnClose="OnCancel">
    <BodyContent>
        <div class="cwm-video-row">
            <div class="cwm-video-text">
                <span class="cwm-video-label">Watch 2-minutes overview video</span>
                <span class="cwm-video-sub">See the full setup process before you start</span>
            </div>
            <button class="cwm-watch-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#6B21A8" stroke="none">
                    <polygon points="5,3 19,12 5,21" />
                </svg>
                Watch video
            </button>
        </div>

        <ul class="cwm-checklist">
            <li class="cwm-checklist-item">
                <span class="cwm-check-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6B21A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="4" />
                    </svg>
                </span>
                <span>Access to Meta Business Manager</span>
            </li>
            <li class="cwm-checklist-item">
                <span class="cwm-check-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6B21A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                </span>
                <span>Approved WhatsApp Business number</span>
            </li>
            <li class="cwm-checklist-item">
                <span class="cwm-check-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6B21A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                <span>Admin permissions on your Meta account</span>
            </li>
            <li class="cwm-checklist-item">
                <span class="cwm-check-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6B21A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </span>
                <span>5–10 minutes to complete the setup</span>
            </li>
        </ul>

        <div class="cwm-info-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span>Your credentials are encrypted and stored securely using industry-standard protocols.</span>
        </div>
    </BodyContent>
    <FooterContent>
        <button class="cwm-btn cwm-btn--cancel" @onclick="OnCancel">Cancel</button>
        <button class="cwm-btn cwm-btn--start" @onclick="OnStartSetup">Start setup</button>
    </FooterContent>
</ModalShell>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnStartSetup { get; set; }
}
