<div class="st-card">
    <h2 class="st-card-title">Profile Information</h2>
    <p class="st-card-sub">Update your personal account details.</p>

    <div class="st-avatar-row">
        <div class="st-avatar-circle">
            <img src="assets/images/avatar.svg" alt="Avatar" class="st-avatar-img" />
        </div>
        <button class="st-upload-btn">Upload image</button>
        <button class="st-remove-btn">Remove</button>
        <span class="st-avatar-hint">JPG, GIF or PNG. 1MB max.</span>
    </div>

    <div class="st-field-row">
        <div class="st-field">
            <label class="st-label">First name</label>
            <input class="st-input" type="text" value="Jon" />
        </div>
        <div class="st-field">
            <label class="st-label">Last name</label>
            <input class="st-input" type="text" value="Doe" />
        </div>
    </div>

    <div class="st-field st-field--email">
        <label class="st-label">Email address</label>
        <input class="st-input" type="email" value="jon.doe@gmail.com" />
    </div>

    <div class="st-card-footer">
        <button class="st-save-btn">Save</button>
    </div>
</div>
