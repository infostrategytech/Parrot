<div class="st-card">
    <h2 class="st-card-title">Workspace Settings</h2>
    <p class="st-card-sub">Business-level configuration and identity.</p>
    <hr class="st-card-divider" />

    <div class="st-field-row">
        <div class="st-field">
            <label class="st-label">Workspace name</label>
            <input class="st-input" type="text" value="Sonia Kitchen" />
        </div>
        <div class="st-field">
            <label class="st-label">Workspace slug</label>
            <input class="st-input" type="text" value="sonia-kitchen" />
        </div>
    </div>

    <div class="st-field-row">
        <div class="st-field">
            <label class="st-label">Default currency</label>
            <div class="st-select-wrap">
                <select class="st-select">
                    <option>NGN</option>
                    <option>USD</option>
                    <option>GBP</option>
                </select>
                <svg class="st-select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>
        </div>
        <div class="st-field">
            <label class="st-label">Time zone</label>
            <div class="st-select-wrap">
                <select class="st-select">
                    <option>(GMT+00:00) UTC</option>
                    <option>(GMT+01:00) Lagos</option>
                </select>
                <svg class="st-select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </div>
        </div>
    </div>

    <div class="st-field">
        <label class="st-label">Business description</label>
        <textarea class="st-textarea"
                  placeholder="e.g. We are family-owned bakery specialized in sourdough and custom cakes"></textarea>
    </div>

    <div class="st-card-footer">
        <button class="st-save-btn">Save</button>
    </div>
</div>
