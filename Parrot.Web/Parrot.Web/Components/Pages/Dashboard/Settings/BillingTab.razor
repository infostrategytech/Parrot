<div class="st-billing">
    <div class="st-card">
        <h2 class="st-card-title">Billing &amp; Usage</h2>
        <p class="st-card-sub">Manage your plan, usage, and payment history.</p>

        <div class="st-plan-row st-card st-card--gray" style="margin-top:18px">
            <div>
                <div class="st-plan-name">Growth <span class="st-plan-badge">Active</span></div>
                <div class="st-plan-desc">Best for growing teams managing customer conversations with AI agents.</div>
                <div class="st-plan-meta">Monthly billing &rarr; Next renewal: Mar 1, 2026</div>
            </div>
            <div class="st-plan-actions">
                <button class="st-save-btn">Upgrade plan</button>
                <button class="st-outline-btn">Manage payment</button>
            </div>
        </div>

        <div class="st-card st-card--gray" style="margin-top:14px;padding:18px 20px">
            <div class="st-usage-title">Usage Overview</div>
            <div class="st-usage-sub">Current billing period usage.</div>
            <div class="st-usage-label-row">
                <span>Conversations</span>
                <span class="st-usage-count">24,400 / 50,000</span>
            </div>
            <div class="st-progress-bar">
                <div class="st-progress-fill" style="width:48.8%"></div>
            </div>
            <div class="st-usage-stats">
                <div class="st-usage-stat">
                    <div class="st-usage-stat-val">24,300</div>
                    <div class="st-usage-stat-label">Conversations Used</div>
                </div>
                <div class="st-usage-stat">
                    <div class="st-usage-stat-val">25,600</div>
                    <div class="st-usage-stat-label">Remaining</div>
                </div>
                <div class="st-usage-stat">
                    <div class="st-usage-stat-val">8</div>
                    <div class="st-usage-stat-label">Active Flows</div>
                </div>
                <div class="st-usage-stat">
                    <div class="st-usage-stat-val">5</div>
                    <div class="st-usage-stat-label">Active AI Agents</div>
                </div>
            </div>
        </div>
    </div>

    <div class="st-card">
        <div class="st-plans-header">
            <div>
                <h2 class="st-card-title">Plans &amp; Upgrades</h2>
                <p class="st-card-sub">Choose the plan that fits your team.</p>
            </div>
            <div class="st-billing-toggle">
                <button class="st-billing-cycle @(_yearly ? "" : "st-billing-cycle--active")"
                        @onclick="() => _yearly = false">Monthly</button>
                <button class="st-billing-cycle @(_yearly ? "st-billing-cycle--active" : "")"
                        @onclick="() => _yearly = true">Yearly</button>
                <span class="st-save-badge">Save 20%</span>
            </div>
        </div>
        <div class="st-plan-cards">
            <div class="st-plan-card">
                <div class="st-plan-card-name">Starter</div>
                <div class="st-plan-card-price">₦800,000<span>/month</span></div>
                <div class="st-plan-card-billing">Billed annually</div>
                <ul class="st-plan-features">
                    <li>Up to 2 AI agents</li>
                    <li>5,000 conversations/month</li>
                    <li>Whatsapp channel only</li>
                    <li>1,000 CRM contacts</li>
                    <li>Basic automation flows</li>
                    <li>Standard support</li>
                </ul>
                <button class="st-plan-btn st-plan-btn--outline">Downgrade plan</button>
            </div>
            <div class="st-plan-card st-plan-card--current">
                <div class="st-plan-card-top">
                    <div class="st-plan-card-name">Growth</div>
                    <span class="st-recommended-badge">Recommended</span>
                </div>
                <div class="st-plan-card-price">₦2,000,000<span>/month</span></div>
                <div class="st-plan-card-billing">Billed annually</div>
                <ul class="st-plan-features">
                    <li>Up to 10 AI agents</li>
                    <li>50,000 conversations/month</li>
                    <li>Multi-channel inbox</li>
                    <li>10,000 CRM contacts</li>
                    <li>Advanced automation flows</li>
                    <li>Priority support</li>
                </ul>
                <button class="st-plan-btn st-plan-btn--ghost" disabled>Current plan</button>
            </div>
            <div class="st-plan-card">
                <div class="st-plan-card-name">Scale</div>
                <div class="st-plan-card-price">₦3,500,000<span>/month</span></div>
                <div class="st-plan-card-billing">Billed annually</div>
                <ul class="st-plan-features">
                    <li>Unlimited AI agents</li>
                    <li>250,000 conversations/month</li>
                    <li>Omnichannel support</li>
                    <li>Unlimited CRM contacts</li>
                    <li>Custom automation logic</li>
                    <li>Dedicated account manager</li>
                </ul>
                <button class="st-plan-btn st-plan-btn--primary">Upgrade plan</button>
            </div>
        </div>
    </div>

    <div class="st-card">
        <h2 class="st-card-title">Payment History</h2>
        <p class="st-card-sub">A record of billing and payment activity</p>
        <table class="st-invoice-table">
            <thead>
                <tr>
                    <th>Invoice ID</th>
                    <th>Amount</th>
                    <th>Date Created</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in _invoices)
                {
                    <tr>
                        <td>@inv.Id</td>
                        <td>@inv.Amount</td>
                        <td>@inv.Date</td>
                        <td><span class="st-inv-status st-inv-status--@inv.StatusClass">@inv.Status</span></td>
                        <td>
                            <div class="st-inv-menu-wrap">
                                <button class="st-inv-more" @onclick="() => ToggleMenu(inv.Id)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2">
                                        <circle cx="12" cy="12" r="1" />
                                        <circle cx="19" cy="12" r="1" />
                                        <circle cx="5" cy="12" r="1" />
                                    </svg>
                                </button>
                                @if (_openMenuId == inv.Id)
                                {
                                    <div class="st-inv-dropdown">
                                        <button class="st-inv-dropdown-item">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                <polyline points="7 10 12 15 17 10" />
                                                <line x1="12" y1="15" x2="12" y2="3" />
                                            </svg>
                                            Download
                                        </button>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="st-table-footer">
            <span class="st-table-count">Showing 1–3 of 3 items</span>
            <button class="st-page-btn">1</button>
        </div>
    </div>
</div>

@code {
    bool _yearly = true;
    string? _openMenuId;

    void ToggleMenu(string id) => _openMenuId = _openMenuId == id ? null : id;

    record Invoice(string Id, string Amount, string Date, string Status, string StatusClass);

    List<Invoice> _invoices =
    [
        new("INV-2024-012", "₦7,000", "10 Oct, 2025 • 10:30 AM", "Pending", "pending"),
        new("INV-2024-011", "₦5,000", "12 Oct, 2025 • 10:30 AM", "Paid", "paid"),
        new("INV-2024-010", "₦15,000", "12 Oct, 2025 • 10:30 AM", "Paid", "paid"),
    ];
}
