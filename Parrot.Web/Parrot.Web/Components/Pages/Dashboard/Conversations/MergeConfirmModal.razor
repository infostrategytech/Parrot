<div class="cv-modal-overlay" @onclick="() => OnCancel.InvokeAsync()">
    <div class="cv-modal cv-modal--merge" @onclick:stopPropagation>
        <div style="display:flex;align-items:flex-start;gap:14px">
            <div class="cv-merge-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
            <div>
                <h2 class="cv-modal-title" style="margin-bottom:6px">Link Customer Accounts</h2>
                <p class="cv-modal-sub">This will combine both customer records and merge all conversations and history.</p>
            </div>
        </div>
        <div class="cv-modal-actions">
            <button class="cv-modal-btn--cancel" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
            <button class="cv-modal-btn--primary" @onclick="() => OnConfirm.InvokeAsync()">Merge contacts</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
