@using Parrot.Web.Components.Pages.Dashboard.Contacts

@if (Contact != null)
{
    <div class="cdp-overlay" @onclick="OnClose"></div>
    <div class="cdp-panel" @onclick:stopPropagation>
        <button class="cdp-close" @onclick="OnClose" aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>

        <div class="cdp-profile">
            <div class="cdp-avatar-wrap">
                @if (!string.IsNullOrEmpty(Contact.AvatarUrl))
                {
                    <img class="cdp-avatar" src="@Contact.AvatarUrl" alt="@Contact.Name" />
                }
                else
                {
                    <div class="cdp-avatar cdp-avatar--placeholder">@Contact.Name[0]</div>
                }
            </div>
            <div class="cdp-name-row">
                <h2 class="cdp-name">@Contact.Name</h2>
                @if (!string.IsNullOrEmpty(Contact.Stage))
                {
                    <span class="cdp-stage-chip cdp-stage-chip--@Contact.Stage.ToLower().Replace(" ", "")">@Contact.Stage</span>
                }
            </div>
            <div class="cdp-tags">
                @foreach (var tag in Contact.Tags)
                {
                    <span class="cdp-tag">@tag</span>
                }
            </div>
            <p class="cdp-last">
                Last interaction: <strong>@Contact.LastInteraction</strong> via @Contact.LastInteractionChannel
            </p>
        </div>

        <div class="cdp-section">
            <h3 class="cdp-section-title">CHANNELS</h3>
            <div class="cdp-channels">
                @if (Contact.HasWhatsApp)
                {
                    <div class="cdp-channel-card">
                        <img src="assets/images/icons/whatsapp.png" alt="WhatsApp" width="22" height="22" />
                        <div>
                            <span class="cdp-channel-name">WhatsApp Business</span>
                            <span class="cdp-channel-handle">@Contact.WhatsAppNumber</span>
                        </div>
                    </div>
                }
                @if (Contact.HasInstagram)
                {
                    <div class="cdp-channel-card">
                        <img src="assets/images/icons/instagram.png" alt="Instagram" width="22" height="22" />
                        <div>
                            <span class="cdp-channel-name">Instagram</span>
                            <span class="cdp-channel-handle">@Contact.InstagramHandle</span>
                        </div>
                    </div>
                }
            </div>
            <div class="cdp-link-btn-wrapper">
                <button class="cdp-link-btn">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                    Link another account
                </button>
            </div>
        </div>

        <div class="cdp-section">
            <h3 class="cdp-section-title">ORDERS</h3>
            <div class="cdp-orders-wrap">
                <table class="cdp-orders-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Item</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in PagedOrders)
                        {
                            <tr>
                                <td class="cdp-order-id">@order.OrderId</td>
                                <td>@order.Item</td>
                                <td class="cdp-order-amount">@order.Amount</td>
                                <td>
                                    <span class="cdp-order-status cdp-order-status--@order.Status.ToLower()">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            @if (order.Status == "Pending")
                                            {
                                                <circle cx="12" cy="12" r="10" />
                                                <polyline points="12 6 12 12 16 14" />
                                            }
                                            else if (order.Status == "Completed")
                                            {
                                                <polyline points="20 6 9 17 4 12" />
                                            }
                                            else
                                            {
                                                <circle cx="12" cy="12" r="10" />
                                                <line x1="15" y1="9" x2="9" y2="15" />
                                                <line x1="9" y1="9" x2="15" y2="15" />
                                            }
                                        </svg>
                                        @order.Status
                                    </span>
                                </td>
                                <td class="cdp-order-date">@order.DateCreated</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="cdp-orders-footer">
                    <span class="cdp-orders-count">Showing @OrderStart–@OrderEnd of @TotalOrders items</span>
                    <div class="cdp-order-pages">
                        <button class="cdp-page-btn" disabled="@(_orderPage == 1)" @onclick="() => _orderPage--">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 18l-6-6 6-6" />
                            </svg>
                        </button>
                        @for (int i = 1; i <= TotalOrderPages; i++)
                        {
                            var pg = i;
                            <button class="cdp-page-btn @(pg == _orderPage ? "cdp-page-btn--active" : "")"
                                    @onclick="() => _orderPage = pg">@pg</button>
                        }
                        <button class="cdp-page-btn" disabled="@(_orderPage == TotalOrderPages)"
                                @onclick="() => _orderPage++">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 18l6-6-6-6" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Contact? Contact { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int _orderPage = 1;
    private int _orderPageSize = 3;

    private int TotalOrders => Contact?.Orders.Count ?? 0;
    private int TotalOrderPages => Math.Max(1, (int)Math.Ceiling(TotalOrders / (double)_orderPageSize));
    private int OrderStart => TotalOrders == 0 ? 0 : (_orderPage - 1) * _orderPageSize + 1;
    private int OrderEnd => Math.Min(_orderPage * _orderPageSize, TotalOrders);
    private IEnumerable<ContactOrder> PagedOrders => Contact?.Orders
        .Skip((_orderPage - 1) * _orderPageSize)
        .Take(_orderPageSize) ?? Enumerable.Empty<ContactOrder>();

    protected override void OnParametersSet() => _orderPage = 1;
}
