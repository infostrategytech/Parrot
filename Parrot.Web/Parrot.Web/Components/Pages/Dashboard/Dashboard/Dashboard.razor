                            <path d="M18.1671 8.33398C17.5043 5.06872 14.9323 2.49675 11.667 1.83398" stroke="currentColor"
                                  stroke-width="1.5" stroke-linecap="round" />
                            <path d="M18.1671 11.666C17.5043 14.9313 14.9323 17.5032 11.667 18.166" stroke="currentColor"
                                  stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </span>
                </div>
                <div class="db-stat-value">8</div>
                <div class="db-stat-desc">Agents handling conversations</div>
            </div>
            <div class="db-stat-card">
                <div class="db-stat-top">
                    <span class="db-stat-label">Connected Channels</span>
                    <span class="db-stat-icon db-stat-icon--green">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                            d="M7.49967 9.99935C7.49967 11.1499 6.56693 12.0827 5.41634 12.0827C4.26575 12.0827 3.33301 11.1499 3.33301 9.99935C3.33301 8.84876 4.26575 7.91602 5.41634 7.91602C6.56693 7.91602 7.49967 8.84876 7.49967 9.99935Z"
                            stroke="currentColor" stroke-width="1.5" />
                            <path d="M11.6667 5.41602L7.5 8.33268" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" />
                            <path d="M11.6667 14.584L7.5 11.6673" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" />
                            <path
                            d="M15.8337 15.4173C15.8337 16.5679 14.9009 17.5007 13.7503 17.5007C12.5997 17.5007 11.667 16.5679 11.667 15.4173C11.667 14.2667 12.5997 13.334 13.7503 13.334C14.9009 13.334 15.8337 14.2667 15.8337 15.4173Z"
                            stroke="currentColor" stroke-width="1.5" />
                            <path
                            d="M15.8337 4.58333C15.8337 5.73393 14.9009 6.66667 13.7503 6.66667C12.5997 6.66667 11.667 5.73393 11.667 4.58333C11.667 3.43274 12.5997 2.5 13.7503 2.5C14.9009 2.5 15.8337 3.43274 15.8337 4.58333Z"
                            stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </span>
                </div>
                <div class="db-stat-value">2</div>
                <div class="db-stat-desc">Messaging platforms linked</div>
            </div>
            <div class="db-stat-card">
                <div class="db-stat-top">
                    <span class="db-stat-label">Team</span>
                    <span class="db-stat-icon db-stat-icon--amber">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="7.50033" cy="4.99935" r="3.33333" stroke="currentColor" stroke-width="1.5" />
                            <path d="M12.5 7.5C13.8807 7.5 15 6.38071 15 5C15 3.61929 13.8807 2.5 12.5 2.5"
                                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <ellipse cx="7.50033" cy="14.1673" rx="5.83333" ry="3.33333" stroke="currentColor"
                                     stroke-width="1.5" />
                            <path
                            d="M15 11.666C16.4619 11.9866 17.5 12.7985 17.5 13.7493C17.5 14.6071 16.6552 15.3518 15.4167 15.7247"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </span>
                </div>
                <div class="db-stat-value">7</div>
                <div class="db-stat-desc">People in your workspace</div>
            </div>
            <div class="db-stat-card">
                <div class="db-stat-top">
                    <span class="db-stat-label">Pending Task Request</span>
                    <span class="db-stat-icon db-stat-icon--orange">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                            d="M2.5 8.33268C2.5 5.18999 2.5 3.61864 3.47631 2.64233C4.45262 1.66602 6.02397 1.66602 9.16667 1.66602H10.8333C13.976 1.66602 15.5474 1.66602 16.5237 2.64233C17.5 3.61864 17.5 5.18999 17.5 8.33268V11.666C17.5 14.8087 17.5 16.3801 16.5237 17.3564C15.5474 18.3327 13.976 18.3327 10.8333 18.3327H9.16667C6.02397 18.3327 4.45262 18.3327 3.47631 17.3564C2.5 16.3801 2.5 14.8087 2.5 11.666V8.33268Z"
                            stroke="currentColor" stroke-width="1.5" />
                            <path d="M6.66699 10H13.3337" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M6.66699 6.66602H13.3337" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" />
                            <path d="M6.66699 13.334H10.8337" stroke="currentColor" stroke-width="1.5"
                                  stroke-linecap="round" />
                        </svg>
                    </span>
                </div>
                <div class="db-stat-value">12</div>
                <div class="db-stat-desc">Tasks waiting for your review</div>
            </div>
            <div class="db-stat-card">
                <div class="db-stat-top">
                    <span class="db-stat-label">Collection Balance</span>
                    <span class="db-stat-icon db-stat-icon--indigo">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                            d="M2.08301 5.41732C2.08301 3.57637 3.57539 2.08398 5.41634 2.08398C7.25729 2.08398 8.74967 3.57637 8.74967 5.41732C8.74967 7.25827 7.25729 8.75065 5.41634 8.75065C3.57539 8.75065 2.08301 7.25827 2.08301 5.41732Z"
                            stroke="currentColor" stroke-width="1.5" />
                            <path
                            d="M11.25 14.5833C11.25 12.7424 12.7424 11.25 14.5833 11.25C16.4243 11.25 17.9167 12.7424 17.9167 14.5833C17.9167 16.4243 16.4243 17.9167 14.5833 17.9167C12.7424 17.9167 11.25 16.4243 11.25 14.5833Z"
                            stroke="currentColor" stroke-width="1.5" />
                            <path
                            d="M17.9163 5.41732C17.9163 3.84597 17.9163 3.0603 17.4282 2.57214C16.94 2.08398 16.1544 2.08398 14.583 2.08398C13.0117 2.08398 12.226 2.08398 11.7378 2.57214C11.2497 3.0603 11.2497 3.84597 11.2497 5.41732C11.2497 6.98867 11.2497 7.77434 11.7378 8.2625C12.226 8.75065 13.0117 8.75065 14.583 8.75065C16.1544 8.75065 16.94 8.75065 17.4282 8.2625C17.9163 7.77434 17.9163 6.98867 17.9163 5.41732Z"
                            stroke="currentColor" stroke-width="1.5" />
                            <path
                            d="M8.74967 14.584C8.74967 13.0126 8.74967 12.227 8.26152 11.7388C7.77336 11.2507 6.98769 11.2507 5.41634 11.2507C3.84499 11.2507 3.05932 11.2507 2.57116 11.7388C2.08301 12.227 2.08301 13.0126 2.08301 14.584C2.08301 16.1553 2.08301 16.941 2.57116 17.4292C3.05932 17.9173 3.84499 17.9173 5.41634 17.9173C6.98769 17.9173 7.77336 17.9173 8.26152 17.4292C8.74967 16.941 8.74967 16.1553 8.74967 14.584Z"
                            stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </span>
                </div>
                <div class="db-stat-value db-stat-value--sm">&#8358; 847,200.00</div>
                <div class="db-stat-desc">Total payments collected</div>
            </div>
        </div>

        <div class="db-chart-card">
            <div class="db-chart-header">
                <h3 class="db-chart-title">AI-Handled Conversations Over Time</h3>
                <div class="db-chart-filters">
                    <div class="db-chart-select-wrap">
                        <span class="db-chart-select-label">Agent:</span>
                        <select class="db-chart-select" @bind="_selectedAgent">
                            <option value="Bakerbot">Bakerbot</option>
                            <option value="Agent2">Support Bot</option>
                        </select>
                    </div>
                    <div class="db-chart-select-wrap">
                        <span class="db-chart-select-label">Channel:</span>
                        <select class="db-chart-select" @bind="_selectedChannel">
                            <option value="Whatsapp">Whatsapp</option>
                            <option value="Instagram">Instagram</option>
                            <option value="Email">Email</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="db-chart-wrap">
                <canvas id="convChart"></canvas>
            </div>
        </div>

    </div>

@code {
    private string _selectedAgent = "Bakerbot";
    private string _selectedChannel = "Whatsapp";

    private readonly string[] _labels = new[]
    {
        "15th Jan","16th Jan","17th Jan","18th Jan","19th Jan","20th Jan",
        "21st Jan","22nd Jan","23rd Jan","24th Jan","25th Jan","26th Jan"
    };

    private readonly double[] _data = new double[]
    {
        50, 23, 28, 30, 20, 40, 35, 42, 48, 70, 65, 35
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", $$"""
                (function() {
                    var ctx = document.getElementById('convChart');
                    if (!ctx) return;
                    if (ctx._chartInstance) { ctx._chartInstance.destroy(); }
                    ctx._chartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: {{System.Text.Json.JsonSerializer.Serialize(_labels)}},
                            datasets: [{
                                data: {{System.Text.Json.JsonSerializer.Serialize(_data)}},
                                borderColor: '#7C3AED',
                                backgroundColor: 'rgba(124,58,237,0.08)',
                                borderWidth: 2,
                                pointRadius: 0,
                                pointHoverRadius: 5,
                                pointHoverBackgroundColor: '#7C3AED',
                                fill: true,
                                tension: 0.45
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { color: '#9CA3AF', font: { size: 11 } }
                                },
                                y: {
                                    beginAtZero: true,
                                    max: 70,
                                    ticks: { stepSize: 10, color: '#9CA3AF', font: { size: 11 } },
                                    grid: { color: 'rgba(0,0,0,0.05)' },
                                    title: { display: true, text: 'Conversations', color: '#9CA3AF', font: { size: 11 } }
                                }
                            }
                        }
                    });
                })();
            """);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("eval", "var c=document.getElementById('convChart'); if(c&&c._chartInstance){c._chartInstance.destroy();}");
    }
}

