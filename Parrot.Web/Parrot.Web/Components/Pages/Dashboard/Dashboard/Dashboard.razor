@page "/dashboard"
@layout DashboardLayout
@using Parrot.Web.Components.Pages.Dashboard.Dashboard
@inject IJSRuntime JS
@implements IAsyncDisposable

<OnboardingModal />

<div class="db-page">

    <div class="db-upgrade-banner">
        <img src="assets/images/icons/banner-wave.png" alt="" class="db-upgrade-wave" aria-hidden="true" />
        <div class="db-upgrade-left">
            <div class="db-upgrade-icon">
                <img src="assets/images/icons/crown-icon.png" alt="" width="40" height="40" />
            </div>
            <div class="db-upgrade-left-text">
                <span class="db-upgrade-title">Get more from your AI agent:</span>
                <span class="db-upgrade-sub"> Unlock advanced flows, QA insights, and higher conversation limits with a
                    paid plan.</span>
                </div>
            </div>
            <a href="/dashboard/pricing" class="db-upgrade-btn">See pricing <svg width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18l6-6-6-6" />
            </svg></a>
        </div>

        <div class="db-setup-card">
            <div class="db-setup-header">
                <div>
                    <h2 class="db-setup-title">Finish setting up your workspace</h2>
                    <p class="db-setup-sub">Complete these steps to start receiving and managing customer messages.</p>
                </div>
                <span class="db-setup-badge">1 of 4 completed</span>
            </div>
            <div class="db-setup-items">
                <div class="db-setup-item db-setup-item--done">
                    <span class="db-setup-check">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                             stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </span>
                    <span class="db-setup-label">Add workspace details</span>
                    <svg class="db-setup-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </div>
                <div class="db-setup-item">
                    <span class="db-setup-check db-setup-check--empty"></span>
                    <span class="db-setup-label">Connect a channel</span>
                    <svg class="db-setup-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </div>
                <div class="db-setup-item">
                    <span class="db-setup-check db-setup-check--empty"></span>
                    <span class="db-setup-label">Create your first AI agent</span>
                    <svg class="db-setup-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </div>
                <div class="db-setup-item">
                    <span class="db-setup-check db-setup-check--empty"></span>
                    <span class="db-setup-label">Create your first playbook</span>
                    <svg class="db-setup-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="db-stats-grid">
            <div class="db-stat-card">
                <div class="db-stat-top">
                    <span class="db-stat-label">Contacts</span>
                    <span class="db-stat-icon db-stat-icon--purple">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="7.50033" cy="4.99935" r="3.33333" stroke="currentColor" stroke-width="1.5" />
                            <path d="M12.5 7.5C13.8807 7.5 15 6.38071 15 5C15 3.61929 13.8807 2.5 12.5 2.5"
                                  stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <ellipse cx="7.50033" cy="14.1673" rx="5.83333" ry="3.33333" stroke="currentColor"
                                     stroke-width="1.5" />
                            <path
                            d="M15 11.666C16.4619 11.9866 17.5 12.7985 17.5 13.7493C17.5 14.6071 16.6552 15.3518 15.4167 15.7247"
                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </span>
                </div>
                <div class="db-stat-value">2,847</div>
                <div class="db-stat-desc">Total customers across all channels</div>
            </div>
            <div class="db-stat-card">
                <div class="db-stat-top">
                    <span class="db-stat-label">AI agents</span>
                    <span class="db-stat-icon db-stat-icon--blue">
