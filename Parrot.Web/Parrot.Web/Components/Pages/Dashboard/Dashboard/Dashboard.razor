                            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <ellipse cx="12.5003" cy="8.75" rx="0.833333" ry="1.25" fill="currentColor" />
                            <ellipse cx="7.50033" cy="8.75" rx="0.833333" ry="1.25" fill="currentColor" />
                            <path d="M1.83301 8.33398C2.49582 5.06872 5.06783 2.49675 8.33311 1.83398" stroke="currentColor"
