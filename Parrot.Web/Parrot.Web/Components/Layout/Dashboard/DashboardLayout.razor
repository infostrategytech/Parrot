@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AiAgentsState AiAgentsState
@implements IDisposable
@using Parrot.Web.Components.Pages.Dashboard.Notification

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <NavMenu />
    </aside>

    <div class="dashboard-main">
        <header class="dashboard-topbar">
            @if (IsBreadcrumb())
            {
                @if (IsAiAgentRoute())
                {
                    <span class="dashboard-topbar-title">
                        AI Agents <span class="topbar-breadcrumb-sep">/</span> @GetAiAgentBreadcrumb()
                    </span>
                }
                else
                {
                    <span class="dashboard-topbar-title">
                        @if (GetPathSegments().LastOrDefault() == "connect-facebook-marketplace")
                        {
                            @:Channels <span class="topbar-breadcrumb-sep">/</span> Connect facebook marketplace
                        }
                        else if (GetPathSegments().LastOrDefault() == "connect-instagram")
                        {
                            @:Channels <span class="topbar-breadcrumb-sep">/</span> Connect instagram
                        }
                        else if (GetPathSegments().LastOrDefault() == "connect-x")
                        {
                            @:Channels <span class="topbar-breadcrumb-sep">/</span> Connect X (formerly Twitter)
                        }
                        else
                        {
                            @:Channels <span class="topbar-breadcrumb-sep">/</span> Connect whatsapp business
                        }
                    </span>
                }
            }
            else
            {
                <span class="dashboard-topbar-title">@GetPageTitle()</span>
            }
            <NotificationDropdown />
        </header>

        <article class="dashboard-content">
            @Body
        </article>
    </div>
</div>

<MascotWidget />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private bool IsBreadcrumb()
    {
        var segs = GetPathSegments();
        return (segs.Length == 1 && segs[0] == "connect-whatsapp") ||
               (segs.Length == 1 && segs[0] == "connect-facebook-marketplace") ||
               (segs.Length == 1 && segs[0] == "connect-instagram") ||
               (segs.Length == 1 && segs[0] == "connect-x") ||
               (segs.Length >= 3 && segs[1] == "ai-agents");
    }

    private bool IsAiAgentRoute()
    {
        var segs = GetPathSegments();
        return segs.Length >= 3 && segs[1] == "ai-agents";
    }

    private string GetAiAgentBreadcrumb()
    {
        var segs = GetPathSegments();
        var agentName = "Agent";
        if (segs.Length >= 3)
        {
            var agent = AiAgentsState.GetAgent(segs[2]);
            agentName = agent?.Name ?? "Agent";
        }
        if (segs.Length >= 5 && segs[3] == "playbooks")
        {
            var agent = AiAgentsState.GetAgent(segs[2]);
            var pb = agent?.Playbooks.FirstOrDefault(p => p.Id == segs[4]);
            var pbName = pb?.Title ?? "New Playbook";
            return $"{agentName} / {pbName}";
        }
        return agentName;
    }

    private string[] GetPathSegments()
    {
        var uri = new Uri(Nav.Uri);
        return uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
    }

    private string GetPageTitle()
    {
        var uri = new Uri(Nav.Uri);
        var segs = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var segment = segs.LastOrDefault() ?? string.Empty;

        return segment switch
        {
            "" or "dashboard" => "Dashboard",
            "ai-agents" => "AI Agents",
            "catalog" => "Catalog",
            "contacts" => "Contacts",
            "task-requests" => "Task Requests",
            "channels" => "Channels",
            "connect-whatsapp" => "Channels",
            "conversations" => "Conversations",
            "team" => "Team",
            "qa-insights" => "QA & Conversation Insight",
            "settings" => "Settings",
            _ => System.Globalization.CultureInfo.CurrentCulture.TextInfo
                    .ToTitleCase(segment.Replace("-", " "))
        };
    }
}
